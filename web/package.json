{
  "name": "harness-remote-web",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "test:i18n": "node --experimental-strip-types src/i18n.test.mjs",
    "preview": "vite preview --host",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios && node scripts/sync-ios-native.mjs",
    "cap:add:ios": "npx cap add ios",
    "test:ui": "node src/ui-regression.test.mjs",
    "test:settings": "node --experimental-strip-types src/helpCommands.test.mjs && node src/settings-regression.test.mjs",
    "test:model": "node src/model-regression.test.mjs",
    "test:events": "node --experimental-strip-types src/opencode-events.test.mjs",
    "test:config": "node --experimental-strip-types src/server-config.test.mjs",
    "test:collab": "bun src/collab/link.test.mjs && bun src/collab/client.test.mjs && bun src/collab/adapter.test.mjs && bun src/collab/attachments.test.mjs && bun src/collab/sessionView.test.mjs && bun src/collab/activityView.test.mjs && bun src/collab/ActivityDisclosure.test.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@oh-my-pi/pi-wire": "17.1.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "5.6.3",
    "vite": "^8.0.14"
  }
}
